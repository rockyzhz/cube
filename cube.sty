% region \gen_arrows_bars_seq:Nnn 函数定义
% 生成插入到 \drawsquares 第三个可选参数的语句
% 储存到一个 seq 变量中，也就是第一个参数
% 第二个参数是 <comma list> ，每一项都是由最多三个字符组成的，
% 比如： ll,rrr,u-u,-dd 代表的是如下情形，顺时针排列，末尾的 '-' 可以省略
%   u   u
%   1 2 3 r
% l 4 5 6 r
% l 7 8 9 r
%   d d
% 第三个参数也是 <comma list> ，每一项由 1-9 的数字中间间隔 - 或 =
% 数字代表方格的顺序如上所示，1-3，代表从方格1画一条方格3的箭头
% 若：1-3-7-1 ，则代表从方格 1 指向 3 ，再从 3 画一条指向 7 ，再从 7 指回 1
%    的三条箭头。
% 若：1=3 ，则代表画一条从方格 1 和 方格 3 之间的双向箭头。
\seq_new:N \l_cube_arrows_bars_seq  % 专门来存储生成的指令
\seq_new:N \l_cube_arrows_barsa_seq % 临用来存储生成的指令
\str_map_inline:nn {abxy} {\int_new:c {l_cube_arrows_ #1 _int}} % 批量定义临时坐标变量
\cs_new_protected:Npn \gen_arrows_bars_seq:Nnn #1#2#3 {
    \seq_clear:N \l_cube_arrows_barsa_seq
    \clist_clear:N \l_tmpa_clist
    \clist_set:Nn \l_tmpa_clist {#2}

    % \seq_put_right:Ne \l_cube_arrows_barsa_seq {
    %     \exp_not:N\pgfset{arrow~keys/width=1pt 4}
    % }

    \clist_map_inline:Nn \l_tmpa_clist {
        \regex_match_case:nn { % 设置旋转角度，只绘制左边的杠，其它的边都是先在左边
            { l }{\int_set:Nn \l_tmpa_int {0}  } % 绘制好之后再绕中心旋转相应的角度
            { u }{\int_set:Nn \l_tmpa_int {-90}}
            { r }{\int_set:Nn \l_tmpa_int {180}}
            { d }{\int_set:Nn \l_tmpa_int {90} }}
          {##1}
        \int_step_inline:nn {\tl_count:n {##1}}{
            \exp_args:Nennn \tl_if_eq:nnTF {\tl_item:nn {##1} {####1}} {-} {\tl_log:n {####1}}{
                \seq_put_right:Ne \l_cube_arrows_barsa_seq {
                    \exp_not:N\draw [rotatearound={\int_use:N \l_tmpa_int},black,line~width=2*\pgflinewidth]
                        (-0.15,####1-0.95) -- +(0,0.9);}
            }
        }
    }

    \clist_clear:N \l_tmpb_clist
    \clist_set:Nn  \l_tmpb_clist {#3}
    \clist_map_inline:Nn \l_tmpb_clist {
        \clist_log:n {##1}
        \int_step_inline:nn {\int_div_truncate:nn {\str_count:n {##1} } {2}} {
            % 获取每一个箭头的首尾的方格标号
            \int_set:Nn \l_tmpa_int {\str_item:nn {##1} {2*####1 - 1}}
            \int_set:Nn \l_tmpb_int {\str_item:nn {##1} {2*####1 + 1}}

            % 把首尾方格标号转换成坐标分别存入四个变量中
            \int_set:Nn \l_cube_arrows_b_int {2 - (\int_div_truncate:nn {\l_tmpa_int - 1} {3})} % 行号 (0,1,2)
            \int_set:Nn \l_cube_arrows_a_int {\int_mod:nn {\l_tmpa_int - 1} {3}}                % 列号 (0,1,2)
            \int_set:Nn \l_cube_arrows_y_int {2 - (\int_div_truncate:nn {\l_tmpb_int - 1} {3})} % 行号 (0,1,2)
            \int_set:Nn \l_cube_arrows_x_int {\int_mod:nn {\l_tmpb_int - 1} {3}}                % 列号 (0,1,2)

            % 根据箭头类型设置绘图语句中的标识
            \exp_args:Nne \regex_match_case:nn {
                { - } {\tl_set:Nn \l_tmpa_tl {-{To[length=3pt, width=4pt]}}}
                { = } {\tl_set:Nn \l_tmpa_tl {{To[length=3pt, width=4pt]}-{To[length=3pt, width=4pt]}}}
                }
                {\str_item:nn {##1} {2*####1}}

            % 先在首尾两点绘制 node ，避免不同的箭头首尾相接
            \seq_put_right:Ne \l_cube_arrows_barsa_seq {
                \exp_not:N\draw (0.5+\int_use:N \l_cube_arrows_a_int,0.5+\int_use:N \l_cube_arrows_b_int) node[inner~sep=1pt] (s) {};
                \exp_not:N\draw (0.5+\int_use:N \l_cube_arrows_x_int,0.5+\int_use:N \l_cube_arrows_y_int) node[inner~sep=1pt] (d) {};
                \exp_not:N\draw[\tl_use:N \l_tmpa_tl,white,line~width=1.2pt] (s) -- (d);}
        }
    }

    % 添加占位的 bouding box ，以便不同的公式示意图保持对齐
    \seq_put_right:Ne \l_cube_arrows_barsa_seq {
        \exp_not:N\useasboundingbox (-0.2,-0.2) rectangle (3.2,3.2);
    }

    \seq_log:N \l_cube_arrows_barsa_seq
    % 将结果存储到第一个参数指定的序列中
    \seq_set_eq:NN #1 \l_cube_arrows_barsa_seq
}
% endregion

