% region \gen_bars_seq:Nn 函数定义
% 生成插入到 \drawsquares 第三个可选参数的语句
% 储存到一个 seq 变量中，也就是第一个参数
% 第二个参数是 <comma list> ，每一项都是由三个字符组成，依顺时针顺序，从左侧下方边条开始，
% 颜色指示字符仅限四种 o/g/r/b ，分别代表 橙色/绿色/红色/蓝色
% 因为顶面和底面已经固定为黄色和白色，所以不需要指示
\seq_new:N \l_cube_bars_seq  % 专门来存储生成的指令
\seq_new:N \l_cube_barsa_seq % 临用来存储生成的指令
\cs_new_protected:Npn \gen_bars_seq:Nn #1#2 {
    \seq_clear:N \l_cube_barsa_seq
    \clist_clear:N \l_tmpa_clist
    \clist_set:Nn \l_tmpa_clist {#2}
    \clist_log:N \l_tmpa_clist
    \int_zero:N \l_tmpa_int

    \clist_map_inline:Nn \l_tmpa_clist {
        \int_zero:N \l_tmpb_int
        \str_map_variable:nNn {##1} \l_tmpa_str {
            \prop_get:NVNF \g_cube_color_map_prop \l_tmpa_str \l_tmpa_tl {\tl_set:Nn \l_tmpa_tl {black!30}\errmessage{Invalid~parameter~for~\gen_bars_seq:Nn}}
            \seq_put_right:Ne \l_cube_barsa_seq {
                \exp_not:N\path[rotatearound={-\int_use:N \l_tmpa_int * 90},fill=\tl_use:N \l_tmpa_tl] (-0.5,0.05+\int_use:N \l_tmpb_int) rectangle +(0.45,0.9);
            }
            \int_incr:N \l_tmpb_int
        }
        \int_incr:N \l_tmpa_int
    }
    \seq_log:N \l_cube_barsa_seq
    % 将结果存储到第一个参数指定的序列中
    \seq_set_eq:NN #1 \l_cube_barsa_seq
}
