% region \drawsquares 函数定义
\int_new:N \l_cube_tmpc_int
\int_new:N \l_cube_tmpb_int
\int_new:N \l_cube_tmpa_int
\bool_new:N \l_cube_udlr_bool
\bool_new:N \l_cube_num_bool
\dim_new:N \l_cube_linewidth_dim
\tl_new:N \l_cube_tmpd_tl
\str_new:N \l_cube_front_expanded
\str_new:N \l_cube_right_expanded

% 主函数：根据字符串绘制彩色正方形（九宫格排列）
% 使用 scope 环境，可以嵌套在其他 tikz 环境中
\NewDocumentCommand \drawsquares { O{} m O{} O{-} } {
    \begin{scope}[#1]
        \regex_match:nnTF
            { [UDLR] }
            {#2}
            {\bool_set_true:N  \l_cube_udlr_bool} % '-'   代表蓝色
            {\bool_set_false:N \l_cube_udlr_bool} % '-' 不代表蓝色

        \regex_match:nnTF
            { [1-9] }
            {#2}
            {\bool_set_true:N  \l_cube_num_bool} % 把红蓝分别设置为 niceblue 和 nicered
            {\bool_set_false:N \l_cube_num_bool} % 保持正常

        \int_zero:N \l_cube_tmpa_int

        % 按行优先顺序排列（第一行，然后第二行，最后第三行）
        \str_map_inline:nn {#2} {
            \bool_if:NTF \l_cube_udlr_bool
                {\str_set:Nn \l_tmpa_str {-}} % 把 UDLR 模式下所有格子背景置为默认灰色
                {}

            \int_incr:N \l_cube_tmpa_int

            % 计算行和列（从0开始）
            \int_set:Nn \l_cube_tmpb_int {\int_div_truncate:nn {\l_cube_tmpa_int - 1} {3}}  % 行号 (0,1,2)
            \int_set:Nn \l_cube_tmpc_int {\int_mod:nn {\l_cube_tmpa_int - 1} {3}}           % 列号 (0,1,2)

            \regex_match_case:nn
            {
                { [1-9] }{
                            \str_set:Nn \l_tmpa_str {#4} % 是数字，背景为灰色
                            \str_set:Nn \l_tmpb_str {##1} % 包含数字，直接使用
                        }
                { [a-z-=] }{
                            \bool_lazy_or:nnTF {\l_cube_udlr_bool} {\l_cube_num_bool}
                                {
                                    \regex_match_case:nn {
                                        { r } {\str_set:Nn \l_tmpa_str {r}} % 数字模式下，把红色改为 nicered
                                        { - } {\str_set:Nn \l_tmpa_str {b}} % 数字模式下，把蓝色改为 niceblue
                                        { . } {\str_set:Nn \l_tmpa_str {##1}} % 数字模式下，其它颜色保持不变
                                    } {##1}}
                                {\str_set:Nn \l_tmpa_str {##1}}
                            \str_set:Nn \l_tmpb_str {}      % 内容置为空
                        }
                { [U] }{\draw[niceblue,line~width=2*\pgflinewidth] (\l_cube_tmpc_int + 0.05, 2 - \l_cube_tmpb_int + 1.15) -- +(0.9,0);}
                { [D] }{\draw[niceblue,line~width=2*\pgflinewidth] (\l_cube_tmpc_int + 0.05, 2 - \l_cube_tmpb_int - 0.15) -- +(0.9,0);}
                { [L] }{\draw[niceblue,line~width=2*\pgflinewidth] (\l_cube_tmpc_int - 0.15, 2 - \l_cube_tmpb_int + 0.05) -- +(0,0.9);}
                { [R] }{\draw[niceblue,line~width=2*\pgflinewidth] (\l_cube_tmpc_int + 1.15, 2 - \l_cube_tmpb_int + 0.05) -- +(0,0.9);}
            }
            {##1}
            

            % 获取颜色
            % \bool_if:NTF \l_tmpa_bool {\str_set:Nn \l_tmpa_str {-}} {\str_set:Nn \l_tmpa_str {##1}}
            \prop_get:NVNF \g_cube_color_map_prop {\l_tmpa_str} \l_cube_tmpd_tl {\str_log:N \l_tmpa_str\tl_set:Nn \l_cube_tmpd_tl {black!30}\errmessage{Invalid~parameter~for~\drawsquares}}

            % 绘制正方形（1cm边长，填充对应颜色，白色描边，2pt线宽）
            % 注意：Y坐标需要反转（第一行在顶部）
            % \bool_if:NTF \l_cube_udlr_bool
            %     {\dim_set:Nn \l_cube_linewidth_dim {4\pgflinewidth}} % 画 OLL 等平面的公式示意图时方格间距宽一点
            %     {\dim_set:Nn \l_cube_linewidth_dim {\pgflinewidth}}  % 作为立体魔方的一部分时，方格间距窄一点
            % \tl_if_empty:oF {#3} {\dim_set:Nn \l_cube_linewidth_dim {4\pgflinewidth}} % 画 PLL 等平面的公式示意图时方格间距宽一点
            \fill[\l_cube_tmpd_tl, draw=black!10,rounded~corners=2pt, line~width=\pgflinewidth]
                (\l_cube_tmpc_int, 2 - \l_cube_tmpb_int) rectangle +(1, 1) node[black, pos=0.5] {\str_use:N \l_tmpb_str};
        }

        % 添加占位的 bouding box ，以便不同的公式示意图保持对齐
        \useasboundingbox (-0.3,-0.3) rectangle (3.3,3.3);

        % 添加额外的作图语句
        #3
    \end{scope}
}
% endregion

% region \drawcube 函数定义
% 魔方绘制函数：绘制三面视图的魔方
\NewDocumentCommand{\drawcube}{ m m m m m }{
    \begin{scope}[3d~cube={#4}]
        % 绘制正面
        \drawsquares[canvas~is~xy~plane~at~z=0]{#1}[][b]

        % 绘制右侧面
        \drawsquares[canvas~is~yz~plane~at~x=3,~rotate=-90]{#2}[][r]

        % 绘制顶面
        \drawsquares[canvas~is~zx~plane~at~y=3,~rotate=~90]{#3}[][y]

        % 其它的绘图语句（如边框等）可以在这里添加
        #5
    \end{scope}
}
% endregion

% region \Cube 函数定义
% 魔方绘制函数：绘制三面视图的魔方
% 接收三个字符串参数和一个可选的尺寸参数
% 第一个参数：正面五个字符（ABCDE -> ABCDbbEbb）
% 第二个参数：右侧面五个字符（ABCDE -> CDEBrrArr）
% 第三个参数：顶面九个字符（直接使用原参数）
% 第四个参数：尺寸参数（可选，默认5mm）
\NewDocumentCommand \Cube { m m m O{5mm} } {
    % 扩展正面参数：ABCDE -> ABCDbbEbb
    \int_case:nn {\str_count:n {#1}} {
        {5} {
            % 正常情况，五个字符
                \str_set:Ne \l_cube_front_expanded {
                    \str_range:nnn {#1} {1} {3}
                    bb
                    \str_item:nn {#1} {4}
                    bb
                    \str_item:nn {#1} {5}
                }
            }
        {9} {
            % 已经是九个字符，直接使用
            \str_set:Ne \l_cube_front_expanded {#1}
        }
    }

    \int_case:nn {\str_count:n {#2}} {
        {5} {
            % 正常情况，五个字符
                % 扩展右侧面参数：ABCDE -> CDEBrrArr
                \str_set:Ne \l_cube_right_expanded {
                    \str_range:nnn {#2} {3} {5}
                    \str_item:nn {#2} {2}
                    rr
                    \str_item:nn {#2} {1}
                    rr
                }
            }
        {9} {
            % 已经是九个字符，直接使用
            \str_set:Ne \l_cube_right_expanded {#2}
            }
    }

    \begin{tikzpicture}
        \exp_args:Noonnn
        \drawcube{\l_cube_front_expanded}{\l_cube_right_expanded}{#3}{#4}{}
    \end{tikzpicture}
}
% endregion

% region \FLL 宏：用于绘制第一二层公式
\int_new:N  \g_cube_fll_index_int
\int_zero:N \g_cube_fll_index_int

% 创建三个 coffin：序号、魔方图、公式
\NewCoffin \l_cube_index_coffin
\NewCoffin \l_cube_cube_coffin
\NewCoffin \l_cube_height_coffin
\NewCoffin \l_cube_formula_coffin

% 创建一个包含序号+内容的 coffin
\NewCoffin \l_cube_output_coffin

% 定义全局变量存储每个FLL的高度
\newlength{\gfllheight}
\setlength{\gfllheight}{0pt}
\newlength{\gfllwidth}
\setlength{\gfllwidth}{0pt}

\NewDocumentCommand \FLL { m m m O{3mm} m } {
    \SetHorizontalCoffin \l_cube_output_coffin {}

    % 自动增长序号
    \int_gincr:N \g_cube_fll_index_int

    % 填充序号
    % \SetHorizontalCoffin \l_cube_index_coffin {\heiti\int_use:N \g_cube_fll_index_int}
    \SetVerticalCoffin \l_cube_index_coffin {2em} {\centering\sffamily\int_compare:nNnTF {\g_cube_fll_index_int} > {9} {\int_use:N \g_cube_fll_index_int} {0\int_use:N \g_cube_fll_index_int}}

    % 缩放到合适大小
    \ScaleCoffin \l_cube_index_coffin {0.65} {0.65}

    % 填充魔方图
    \SetHorizontalCoffin \l_cube_cube_coffin {
        \Cube{#1}{#2}{#3}[#4]
    }

    % 撑起高度 coffin（用于垂直居中对齐）
    \SetHorizontalCoffin \l_cube_height_coffin {\rule{0pt}{11.7ex}}

    % 填充公式
    \tl_set:Ne \l_tmpa_tl {#5}

    % 注意：不要删除空格，否则无法正确断行
    \regex_replace_all:nnN { [\ ]+ } { } \l_tmpa_tl

    % 设置公式 coffin 宽度以及格式
    \SetVerticalCoffin \l_cube_formula_coffin {3cm} {\raggedright\sffamily\heiti\l_tmpa_tl}

    % 缩放到合适大小
    \ScaleCoffin \l_cube_formula_coffin {0.65} {0.65}

    % 连接魔方和公式（水平对齐）
    \JoinCoffins \l_cube_output_coffin [hc,vc] \l_cube_index_coffin [l,vc]
    % \JoinCoffins \l_cube_output_coffin [\l_cube_index_coffin-r,\l_cube_index_coffin-vc] \l_cube_cube_coffin [l,vc] (.5em,0pt)
    \JoinCoffins \l_cube_output_coffin [\l_cube_index_coffin-l,\l_cube_index_coffin-t] \l_cube_cube_coffin [l,t] (0pt,0pt)
    \JoinCoffins \l_cube_output_coffin [\l_cube_cube_coffin-r,\l_cube_cube_coffin-vc] \l_cube_height_coffin [hc,vc]
    \JoinCoffins \l_cube_output_coffin [\l_cube_cube_coffin-r,\l_cube_cube_coffin-vc] \l_cube_formula_coffin [l,vc] (-2pt,0pt)

    % 缩放整体到合适大小
    % \ScaleCoffin \l_cube_output_coffin {0.65} {0.65}

    % 输出（上下居中对齐）
    % \vspace{3pt}
    \TypesetCoffin \l_cube_output_coffin [b,l]
    % \vspace{3pt}
}
% endregion

% region \str_replace_char_tl:Nnn 函数定义
% 替换字符串某个位置上的字符
\cs_new:Npn \str_replace_char_tl:Nnn #1 #2 #3 {
  % 将字符串转换为token list，然后替换
  \tl_clear:N \l_tmpa_tl
  \tl_clear:N \l_tmpb_tl
  \exp_args:NNe \tl_set:Nn \l_tmpa_tl { #1 }
  \tl_set:Nn \l_tmpb_tl {
    \tl_range:Nnn \l_tmpa_tl { 1 } { #2 - 1 }
    #3
    \tl_range:Nnn \l_tmpa_tl { #2 + 1 } { -1 }
  }
  \str_set:Ne #1 { \l_tmpb_tl }
}
% endregion

% region \cubearrows 函数定义
\seq_new:N \l_cube_notationa_seq % 存储多条绘图命令
\str_map_inline:Nn {abcd} {\tl_new:c {l_cube_notation #1 _tl}}  % 批量定义变量
    % \tl_new:N \l_cube_notationa_tl % 存储绘图参数
    % \tl_new:N \l_cube_notationb_tl % 存储绘图参数
    % \tl_new:N \l_cube_notationc_tl % 存储绘图参数
    % \tl_new:N \l_cube_notationd_tl % 临时存储由 \l_cube_notation_clist 拆解出来的每一个层数
\seq_new:N \l_cube_notationb_seq % 存储多个绘图参数
\bool_new:N \l_cube_notation_bool % 顺时针为真，逆时针为假
\clist_new:N \l_cube_notation_clist % 旋转层数列表
\fp_new:N \l_cube_font_scale_fp % 字体放大比例
\dim_new:N \l_cube_unit_dim % 单位长度
\str_new:N \l_cube_notation_front_str % 正面颜色字符串
\str_new:N \l_cube_notation_right_str % 右面颜色字符串
\str_new:N \l_cube_notation_top_str % 顶面颜色字符串
\NewDocumentCommand{\cubearrows}{ m m }{
    \str_map_inline:Nn {abcd} {\tl_clear:c {l_cube_notation #1 _tl}}
    \seq_clear:N \l_cube_notationa_seq
    \seq_clear:N \l_cube_notationb_seq
    \bool_set_false:N \l_cube_notation_bool
    \clist_clear:N \l_cube_notation_clist
    \str_set:Nn \l_cube_notation_front_str {---------} % 默认正面颜色均为灰色
    \str_set:Nn \l_cube_notation_right_str {---------} % 默认右面颜色均为灰色
    \str_set:Nn \l_cube_notation_top_str   {---------} % 默认顶面颜色均为灰色
    \l_cube_unit_dim=#2
    \pgfmathsetmacro{\scaleFactor}{\l_cube_unit_dim/3mm}
    \regex_match_case_all:nn
        {
            { [LDF] } {\clist_set:Nn \l_cube_notation_clist {1}} % 表示旋转所在方向第一层
            { [SME] } {\clist_set:Nn \l_cube_notation_clist {2}} % 表示旋转所在方向第两层
            { [RUB] } {\clist_set:Nn \l_cube_notation_clist {3}} % 表示旋转所在方向第三层
            { [ldf] } {\clist_set:Nn \l_cube_notation_clist {1,2}} % 表示旋转所在方向前两层
            { [rub] } {\clist_set:Nn \l_cube_notation_clist {2,3}} % 表示旋转所在方向后两层
            { [xyz] } {\clist_set:Nn \l_cube_notation_clist {1,2,3}} % 表示在该方向旋转所有层
            { [RrUuFfSxyz]} {\bool_set_true:N \l_cube_notation_bool} % 顺时针旋转
            { ['] } {\bool_set_inverse:N \l_cube_notation_bool} % 逆转旋转方向
            { [2] } {\seq_put_right:Ne \l_cube_notationa_seq {
                            \exp_not:N\node[orange,scale=\scaleFactor,fill=white,inner~sep=1pt] at (4,2) {$\times2$};}
                    }
            { [rRLlMx] } { % 旋转所在平面为 yz 平面
                            \tl_put_right:Nn \l_cube_notationc_tl {yz~plane}
                            \clist_if_in:NnTF \l_cube_notation_clist {3}
                                {\str_set:Nn \l_cube_notation_right_str {=========}} % 右侧面颜色变为深灰色
                                {}
                            \clist_map_variable:NNn \l_cube_notation_clist \l_cube_notationd_tl {
                                \int_step_inline:nn {3} {
                                    \exp_args:NNen\str_replace_char_tl:Nnn \l_cube_notation_front_str {\int_eval:n {##1*3+\l_cube_notationd_tl-3}} {=}
                                    \exp_args:NNen\str_replace_char_tl:Nnn \l_cube_notation_top_str   {\int_eval:n {##1*3+\l_cube_notationd_tl-3}} {=}
                                }
                            }
                         }
            { [uUDdEy] } { % 旋转所在平面为 zx 平面
                            \tl_put_right:Nn \l_cube_notationc_tl {zx~plane}
                            \clist_if_in:NnTF \l_cube_notation_clist {3}
                                {\str_set:Nn \l_cube_notation_top_str {=========}} % 顶面颜色变为深灰色
                                {}
                            \clist_map_variable:NNn \l_cube_notation_clist \l_cube_notationd_tl {
                                \int_step_inline:nn {3} {
                                    \exp_args:NNen\str_replace_char_tl:Nnn \l_cube_notation_front_str {\int_eval:n {9+##1-3*\l_cube_notationd_tl}} {=}
                                    \exp_args:NNen\str_replace_char_tl:Nnn \l_cube_notation_right_str {\int_eval:n {9+##1-3*\l_cube_notationd_tl}} {=}
                                }
                            }
                         }
            { [fFBbSz] } { % 旋转所在平面为 xy 平面
                            \tl_put_right:Nn \l_cube_notationc_tl {xy~plane}
                            \clist_if_in:NnTF \l_cube_notation_clist {1}
                                {\str_set:Nn \l_cube_notation_front_str {=========}} % 正面颜色变为深灰色
                                {}
                            \clist_map_variable:NNn \l_cube_notation_clist \l_cube_notationd_tl {
                                \int_step_inline:nn {3} {
                                    \exp_args:NNen\str_replace_char_tl:Nnn \l_cube_notation_top_str     {\int_eval:n {9+##1-3*\l_cube_notationd_tl}} {=}
                                    \exp_args:NNen\str_replace_char_tl:Nnn \l_cube_notation_right_str   {\int_eval:n {##1*3+\l_cube_notationd_tl-3}} {=}
                                }
                            }
                         }
        }
        {#1}
    \bool_if:NTF \l_cube_notation_bool
        { \tl_put_right:Nn \l_cube_notationa_tl   {     clockwise} }
        { \tl_put_right:Nn \l_cube_notationa_tl   { anticlockwise} }
    \clist_map_variable:NNn \l_cube_notation_clist \l_cube_notationd_tl {
        \seq_put_right:Ne \l_cube_notationa_seq {
            \exp_not:N\draw [ \l_cube_notationa_tl={#2}, \l_cube_notationc_tl={\l_cube_notationd_tl} ]
                (0,-0.2) .. controls (-0.5,3.5) .. (3.5,3);
        }
    }

    % 添加占位的 bouding box ，以便不同的公式示意图保持对齐
    \seq_put_right:Ne \l_cube_notationa_seq {
        \exp_not:N\useasboundingbox (-0.5,-1.5) (6.5,5.5);
    }

    \exp_args:Nooono
    \drawcube
        {\l_cube_notation_front_str}
        {\l_cube_notation_right_str}
        {\l_cube_notation_top_str}
        {#2}
        {\seq_use:Nn \l_cube_notationa_seq {}}
}
