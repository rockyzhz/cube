    \int_gincr:N \g_cube_pll_index_int
    \SetVerticalCoffin \l_cube_index_coffin {2em} {\centering\sffamily\int_compare:nNnTF {\g_cube_pll_index_int} > {9} {\int_use:N \g_cube_pll_index_int} {0\int_use:N \g_cube_pll_index_int}\\[-5pt]#3}

    % 缩放整体到合适大小
    \ScaleCoffin \l_cube_index_coffin {0.65} {0.65}

    \SetHorizontalCoffin \l_cube_cube_coffin {
        \gen_arrows_bars_seq:Nnn \l_cube_arrows_bars_seq {#1} {#2}
        \seq_log:N \l_cube_arrows_bars_seq
        \begin{tikzpicture}
            \drawsquares[x=#5,y=#5]{bbbbbbbbb}[\seq_use:Nn \l_cube_arrows_bars_seq {}]
        \end{tikzpicture}}

    % 填充公式
    \tl_set:Ne \l_tmpa_tl {#4}

    % 注意：不要删除空格，否则无法正确断行
    \regex_replace_all:nnN { [\ ]+ } { } \l_tmpa_tl

    % 设置公式 coffin 宽度以及格式
    \SetVerticalCoffin \l_cube_formula_coffin {3cm} {\raggedright\sffamily\heiti\l_tmpa_tl}

    % 缩放整体到合适大小
    \ScaleCoffin \l_cube_formula_coffin {0.65} {0.65}

    % 撑起高度 coffin（用于垂直居中对齐）
    \SetHorizontalCoffin \l_cube_height_coffin {\rule{0pt}{11.7ex}}

    % 连接魔方和公式（水平对齐）
    \JoinCoffins \l_cube_output_coffin [hc,vc] \l_cube_index_coffin [l,vc]
    \JoinCoffins \l_cube_output_coffin [\l_cube_index_coffin-r,\l_cube_index_coffin-vc] \l_cube_cube_coffin [l,vc] (.5em,0pt)
    % \JoinCoffins \l_cube_output_coffin [\l_cube_index_coffin-l,\l_cube_index_coffin-t] \l_cube_cube_coffin [l,b] (0pt,1ex)
    \JoinCoffins \l_cube_output_coffin [\l_cube_cube_coffin-r,\l_cube_cube_coffin-vc] \l_cube_height_coffin [hc,vc]
    \JoinCoffins \l_cube_output_coffin [\l_cube_cube_coffin-r,\l_cube_cube_coffin-vc] \l_cube_formula_coffin [l,vc] (.5em,0pt)

    % 输出（上下居中对齐）
    % \vspace{3pt}
    \TypesetCoffin \l_cube_output_coffin [b,l]
    % \vspace{3pt}
}
