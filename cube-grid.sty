\tikzset{3d cube/.style={
    x={(340:0.8*#1)},  % 从330改为345，更接近水平
    y={( 90:  1*#1)},
    z={(200:0.8*#1)}   % 从210改为195，更接近水平
}}
\tikzset{
    xy plane/.style={canvas is xy plane at z=-#1+0.5,rotate around={-90:(1.5,1.5)}},
    zx plane/.style={canvas is zx plane at y=#1-0.5,rotate=90,rotate around={180:(1.5,1.5)}},
    yz plane/.style={canvas is yz plane at x=#1-0.5,rotate=-90},
    clockwise/.style={-{Stealth[length=0.5*#1]},red,line width=.1*#1},
    anticlockwise/.style={{Stealth[length=0.5*#1]}-,red,line width=.1*#1},
}

