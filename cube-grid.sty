\ExplSyntaxOff

% 魔方绘制函数：绘制三面视图的魔方
\NewDocumentCommand{\drawcube}{ m m m m m }{
    \begin{scope}[3d cube={#4}]
        % 绘制正面
        \drawsquares{canvas is xy plane at z=0}{#1}

        % 绘制右侧面（带倾斜效果）
        \drawsquares{canvas is yz plane at x=3, rotate=-90}{#2}

        % 绘制顶面（带倾斜效果）
        \drawsquares{canvas is zx plane at y=3, rotate= 90}{#3}

        % 其它的绘图语句（如边框等）可以在这里添加
        #5
    \end{scope}
}

